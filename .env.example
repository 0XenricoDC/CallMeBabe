# Centralino AI — Phase 1 environment variables.
# Copy this file to `.env` and fill in your own keys. NEVER commit `.env`.
# All keys are loaded via python-dotenv; no key is ever hardcoded in source.

# Deepgram API Key — create account at https://console.deepgram.com
# Free tier: 12,000 minutes/year. Used for Italian streaming STT.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Anthropic API Key — create account at https://console.anthropic.com
# Billing required; Claude Haiku 4.5: ~$1/MTok input, ~$5/MTok output. The LLM "brain".
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs API Key — create account at https://elevenlabs.io
# Free tier: 10,000 characters/month. Used for Italian TTS (per-tenant voice cloning).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID for the demo tenant — find at https://elevenlabs.io/voice-library
# Default below is an Italian-capable pre-made voice; validate quality and replace if needed.
DEMO_VOICE_ID=ErXwobaYiN019PkySvjV

# --- Phase 2: Google Calendar integration ---
# Used for writing confirmed reservations to the demo tenant's Google Calendar.
# All automated tests use InMemoryCalendarProvider — these keys are only needed for
# the live manual verification (real calendar write after verbal confirmation).

# Path to the Google Cloud service-account JSON key file.
# Create at: Google Cloud Console → IAM & Admin → Service Accounts → create key (JSON).
# Share the demo calendar with the service-account email (write access).
# Enable the Google Calendar API: APIs & Services → Library → Google Calendar API → Enable.
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Google Calendar ID for the demo tenant restaurant.
# This is a REAL calendar's ID (your Gmail address, or a dedicated calendar's
# ...@group.calendar.google.com), NOT the service-account email.
# Find at (desktop only): calendar.google.com → calendar → Settings and sharing →
# "Integrate calendar" → "Calendar ID". Share that calendar with the service-account
# email ("Make changes to events") so the service account can write to it.
GOOGLE_CALENDAR_ID_DEMO=your-demo-calendar-id@group.calendar.google.com

